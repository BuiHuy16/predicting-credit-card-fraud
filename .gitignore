# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Coverage, build, and packaging artifacts
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db


# Generated outputs (keep directory placeholders)
/outputs/models/*
!/outputs/models/.gitkeep
/outputs/figures/*
!/outputs/figures/.gitkeep
/outputs/logs/*
!/outputs/logs/.gitkeep
/outputs/submissions/*
!/outputs/submissions/.gitkeep

# Model checkpoints and serialized artifacts
*.ckpt
*.h5
*.joblib
*.keras
*.onnx
*.pkl
*.pt
*.pth

# Experiment trackers and generated run artifacts
wandb/
mlruns/
lightning_logs/
/experiments/**/artifacts/
/experiments/**/checkpoints/
/experiments/**/logs/

# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.json
kaggle.json
/configs/*local*
/configs/*secret*
/configs/*credential*

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

catboost_info/
outputs/predictions/